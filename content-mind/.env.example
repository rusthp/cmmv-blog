# ContentMind — ProPlay News
# Copy to .env and fill in values

# cmmv-blog API (ProPlay News)
PROPLAY_API_URL=http://localhost:5000
PROPLAY_USERNAME=admin
PROPLAY_PASSWORD=your_admin_password_here

# Groq AI
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Scanner settings
REDDIT_POSTS_PER_GAME=5
YOUTUBE_VIDEOS_PER_GAME=5
SCAN_PERIOD=week

# Run settings
GAMES_PER_RUN=3

# Open-topic discovery (streamers, viral gaming culture — outside game_registry)
OPEN_TOPICS_PER_RUN=1

# Images — last-resort stock photo when no source has one (Pexels, free)
PEXELS_API_KEY=
